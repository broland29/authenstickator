{
  "logger": {
    "log_level": "DEBUG",
    "log_file_path": "log.txt"
  },
  "encryptor": {
    "type": "AES"
  },
  "storage": {
    "storage_file_path": "test-storage.txt"
  },
  "tpm": {
    "enabled": true,
    "virtual": {
      "fapi_profile": "P_RSA2048SHA256",
      "fapi_profile_url": "https://raw.githubusercontent.com/tpm2-software/tpm2-tss/3.2.0/dist/fapi-profiles/P_RSA2048SHA256.json",
      "enabled": true,
      "tpm_path": "/tmp/vtpm",
      "tpm_port": 2321,
      "tpm_ctrl_port": 2322,
      "tpm_start_wait_s": 1
    }
  }
}